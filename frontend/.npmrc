# --- Supply-chain hardening for the BigTreeTable frontend ---
#
# minimum-release-age:
#   Block any package whose latest publish is younger than 7 days. Recent
#   ecosystem incidents (chalk/debug 2024, lottie-player 2024, eslint-config-*
#   2024) showed that many supply-chain attacks are caught and yanked within
#   the first 1–7 days. Holding installs back by a week filters most of them.
#
#   Requires pnpm >= 9.x; documented at
#     https://pnpm.io/settings#minimumreleaseage
#
#   Override per-install with `--minimum-release-age 0` if a hotfix must ship
#   immediately, but that should be a deliberate, reviewed exception.
minimum-release-age = 10080  # 60 * 24 * 7 = 7 days, in minutes

# Exact-only resolution: every dependency in package.json is pinned to an exact
# version, so resist any save that would re-introduce ^ / ~ ranges.
save-exact = true
save-prefix = ""

# Strict peer-dep handling — fail builds (not warn) when peers are unmet so we
# can't drift quietly into incompatible transitive trees.
strict-peer-dependencies = true

# Audit on install so reachable advisories surface immediately.
audit-level = moderate

# Fail install if integrity sums don't match the lockfile (default but explicit).
verify-store-integrity = true
