# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/public/assets

# SimpleCov reports.
/coverage

# Sorbet runtime caches and tapioca-generated transient files. The committed
# RBI directory itself stays under version control so type checks reproduce.
/sorbet/tapioca/require.rb.bak

# Rails secrets / encrypted credentials decryption keys — never commit.
/config/master.key
/config/credentials/*.key

# OS noise.
.DS_Store
**/.DS_Store

# Frontend build / cache (the source stays committed).
/frontend/node_modules
/frontend/dist
/frontend/.vite
/frontend/test-results
/frontend/playwright-report
/frontend/coverage
